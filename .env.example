# Copy to the Vercel project environment. Do not commit real values.
# Generate GMAIL_TOKEN_KEY and NOMAD_VAULT_SECRET with: openssl rand -base64 32
# NOMAD_VAULT_SECRET must be the same value on the PocketBase instance.

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GMAIL_TOKEN_KEY=
NOMAD_VAULT_SECRET=
POCKETBASE_ORIGIN=https://nomad.pockethost.io
NOMAD_PUBLIC_ORIGIN=https://nomad-taupe-omega.vercel.app
GOOGLE_OAUTH_REDIRECT_URI=https://nomad-taupe-omega.vercel.app/api/gmail/callback
