@@ -0,0 +1,123 @@
+import 'package:flutter/material.dart';
+
+import '../data/countries.dart';
+import '../engine/models.dart';
+import '../state/app_controller.dart';
+import 'format.dart';
+import 'stay_editor.dart';
+
+class StaysPage extends StatelessWidget {
+  const StaysPage({super.key, required this.controller});
+
+  final AppController controller;
+
+  @override
+  Widget build(BuildContext context) {
+    final rows = controller.stays.where((stay) {
+      return stay.start.year <= controller.year &&
+          stay.end.year >= controller.year;
+    }).toList()..sort((a, b) => b.start.compareTo(a.start));
+    return ListView(
+      padding: const EdgeInsets.fromLTRB(20, 8, 20, 32),
+      children: [
+        Row(
+          children: [
+            Expanded(
+              child: Text(
+                'Stays in ${controller.year}',
+                style: Theme.of(context).textTheme.headlineSmall,
+              ),
+            ),
+            FilledButton.icon(
+              onPressed: () => _edit(context, null),
+              icon: const Icon(Icons.add),
+              label: const Text('Add stay'),
+            ),
+          ],
+        ),
+        const SizedBox(height: 8),
+        const Text(
+          'A wake-up stay is the country of that morning. A layover stays beside it. Saving a stay with an evidence status that does not count leaves the days unknown.',
+        ),
+        const SizedBox(height: 12),
+        if (rows.isEmpty)
+          const Card(
+            child: Padding(
+              padding: EdgeInsets.all(16),
+              child: Text('No stays overlap this year.'),
+            ),
+          )
+        else
+          for (final stay in rows)
+            Card(
+              child: ListTile(
+                title: Text(
+                  stay.role == PresenceRole.primary ||
+                          stay.role == PresenceRole.layover
+                      ? countryLabel(stay.countryCode)
+                      : stay.role.label,
+                ),
+                subtitle: Text(
+                  '${shortRange(stay.start, stay.end)} · ${stay.role.label} · ${stay.evidenceStatus} · ${stay.inference.label} · ${stay.phase.label}',
+                ),
+                trailing: Wrap(
+                  spacing: 4,
+                  children: [
+                    IconButton(
+                      tooltip: 'Edit',
+                      onPressed: () => _edit(context, stay),
+                      icon: const Icon(Icons.edit_outlined),
+                    ),
+                    IconButton(
+                      tooltip: 'Delete',
+                      onPressed: () => _delete(context, stay),
+                      icon: const Icon(Icons.delete_outline),
+                    ),
+                  ],
+                ),
+              ),
+            ),
+      ],
+    );
+  }
+
+  Future<void> _edit(BuildContext context, Stay? stay) async {
+    final edited = await showStayEditor(
+      context,
+      existing: stay,
+      statuses: controller.statuses,
+    );
+    if (edited == null || !context.mounted) return;
+    final failure = await controller.saveStay(edited);
+    if (failure != null && context.mounted) {
+      ScaffoldMessenger.of(context)
+          .showSnackBar(SnackBar(content: Text(failure)));
+    }
+  }
+
+  Future<void> _delete(BuildContext context, Stay stay) async {
+    final confirmed = await showDialog<bool>(
+      context: context,
+      builder: (context) => AlertDialog(
+        title: const Text('Delete this stay?'),
+        content: Text(shortRange(stay.start, stay.end)),
+        actions: [
+          TextButton(
+            onPressed: () => Navigator.pop(context, false),
+            child: const Text('Keep'),
+          ),
+          FilledButton(
+            onPressed: () => Navigator.pop(context, true),
+            child: const Text('Delete'),
+          ),
+        ],
+      ),
+    );
+    if (confirmed != true) return;
+    final failure = await controller.deleteStay(stay.id);
+    if (failure != null && context.mounted) {
+      ScaffoldMessenger.of(context)
+          .showSnackBar(SnackBar(content: Text(failure)));
+    }
+  }
+}
diff --git a/lib/ui/summary_page.dart b/lib/ui/summary_page.dart
new file mode 100644
index 0000000..e57d86f
--- /dev/null
+++ b/lib/ui/summary_page.dart
@@ -0,0 +1,214 @@
+import 'package:flutter/material.dart';
+
+import '../data/countries.dart';
+import '../state/app_controller.dart';
+import 'format.dart';
+import 'theme.dart';
+
+class SummaryPage extends StatelessWidget {
+  const SummaryPage({super.key, required this.controller});
+
+  final AppController controller;
+
+  @override
+  Widget build(BuildContext context) {
+    final tally = controller.tally;
+    final entries = tally.primaryDays.entries.toList()
+      ..sort((a, b) => b.value.compareTo(a.value));
+    final maxDays = entries.isEmpty
+        ? 1
+        : entries.map((entry) => entry.value).reduce((a, b) => a > b ? a : b);
+    final window = tally.windowStart == null
+        ? 'This year is still ahead, so the actual total is empty.'
+        : '${shortDate(tally.windowStart!)} through ${shortDate(tally.windowEnd!)}';
+    final bookingCounts = controller.statuses.any(
+      (status) => status.id == 'booking_only' && status.countsAsActual,
+    );
+    return ListView(
+      padding: const EdgeInsets.fromLTRB(20, 8, 20, 32),
+      children: [
+        Text(
+          '${tally.year} presence',
+          style: Theme.of(context).textTheme.headlineMedium
+              ?.copyWith(fontWeight: FontWeight.w600),
+        ),
+        const SizedBox(height: 6),
+        Text(window),
+        const SizedBox(height: 16),
+        _Card(
+          child: Column(
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              Text(
+                '${tally.primaryCountryDays} wake-up country days',
+                key: const Key('primary-total'),
+                style: Theme.of(context).textTheme.headlineSmall,
+              ),
+              const SizedBox(height: 6),
+              Text(
+                '${tally.primaryCountryDays} country days + ${tally.transitWakeDays} in-transit wake-ups + ${tally.gapDays} unknown days + ${tally.overlapDays} unresolved days = ${tally.windowLength} days in this window.',
+                key: const Key('identity-line'),
+              ),
+              if (!tally.identityHolds) ...[
+                const SizedBox(height: 8),
+                const Text(
+                  'The day parts do not add up to the window. Treat this year as unreliable until that is fixed.',
+                ),
+              ],
+            ],
+          ),
+        ),
+        if (bookingCounts)
+          const _Card(
+            child: Text(
+              'Booking-only records are set to count. That is your choice, and it treats an uncorroborated booking as presence.',
+            ),
+          ),
+        if (controller.rules.includeInferred)
+          const _Card(
+            child: Text(
+              'Records still marked as inference are included because that rule is on.',
+            ),
+          ),
+        const SizedBox(height: 8),
+        Text(
+          'Wake-up countries',
+          style: Theme.of(context).textTheme.titleMedium,
+        ),
+        const SizedBox(height: 8),
+        if (entries.isEmpty)
+          const _Card(
+            child: Text(
+              'No wake-up country is assigned in this window. Unknown days are left empty.',
+            ),
+          )
+        else
+          for (final entry in entries)
+            _CountryBar(
+              code: entry.key,
+              days: entry.value,
+              maxDays: maxDays,
+              marker: controller.rules.personalDayMarker,
+            ),
+        const SizedBox(height: 16),
+        Text(
+          'Separate from the wake-up total',
+          style: Theme.of(context).textTheme.titleMedium,
+        ),
+        const SizedBox(height: 8),
+        _Card(
+          child: Column(
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              const Text(
+                'Layovers',
+                style: TextStyle(fontWeight: FontWeight.w600),
+              ),
+              const SizedBox(height: 4),
+              const Text(
+                'These days already have a wake-up country in the total above. The layover is listed so it is not added again.',
+              ),
+              const SizedBox(height: 8),
+              if (tally.layoverDays.isEmpty)
+                const Text('No layover presence in this window.')
+              else
+                for (final entry in tally.layoverDays.entries)
+                  Text(
+                    '${countryLabel(entry.key)} · ${entry.value} day${entry.value == 1 ? '' : 's'}',
+                  ),
+              const SizedBox(height: 12),
+              const Text(
+                'Overnight nights in transit',
+                style: TextStyle(fontWeight: FontWeight.w600),
+              ),
+              const SizedBox(height: 4),
+              Text(
+                '${tally.overnightNights} night${tally.overnightNights == 1 ? '' : 's'}. Kept out of the country total.',
+              ),
+              const SizedBox(height: 12),
+              Text(
+                'In-transit wake-ups: ${tally.transitWakeDays}. These are already inside the identity total.',
+              ),
+            ],
+          ),
+        ),
+        const SizedBox(height: 8),
+        _Card(
+          child: Text(
+            '${tally.excluded.length} actual-phase record${tally.excluded.length == 1 ? '' : 's'} in this window ${tally.excluded.length == 1 ? 'is' : 'are'} outside the total. Planned trips: ${tally.planned.length}. Future-dated actual stays touching this year: ${tally.futureActual.length}.',
+          ),
+        ),
+        const SizedBox(height: 12),
+        const Text(
+          'These are day counts under the rules on the Rules page. They are not a tax, immigration, or legal determination.',
+          style: TextStyle(color: Color(0xFF5C564E)),
+        ),
+      ],
+    );
+  }
+}
+
+class _CountryBar extends StatelessWidget {
+  const _CountryBar({
+    required this.code,
+    required this.days,
+    required this.maxDays,
+    required this.marker,
+  });
+
+  final String code;
+  final int days;
+  final int maxDays;
+  final int? marker;
+
+  @override
+  Widget build(BuildContext context) {
+    final reached = marker != null && marker! > 0 && days >= marker!;
+    return Padding(
+      padding: const EdgeInsets.only(bottom: 10),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Row(
+            children: [
+              Expanded(child: Text(countryLabel(code))),
+              Text('$days'),
+            ],
+          ),
+          const SizedBox(height: 4),
+          ClipRRect(
+            borderRadius: BorderRadius.circular(99),
+            child: LinearProgressIndicator(
+              minHeight: 8,
+              value: days / maxDays,
+              color: countryColor(code),
+              backgroundColor: line,
+            ),
+          ),
+          if (reached)
+            Padding(
+              padding: const EdgeInsets.only(top: 4),
+              child: Text(
+                'Reaches your marker of $marker. That marker is a reminder you chose.',
+                style: const TextStyle(color: Color(0xFF5C564E)),
+              ),
+            ),
+        ],
+      ),
+    );
+  }
+}
+
+class _Card extends StatelessWidget {
+  const _Card({required this.child});
+
+  final Widget child;
+
+  @override
+  Widget build(BuildContext context) {
+    return Card(
+      margin: const EdgeInsets.only(bottom: 12),
+      child: Padding(padding: const EdgeInsets.all(16), child: child),
+    );
+  }
+}
diff --git a/lib/ui/theme.dart b/lib/ui/theme.dart
new file mode 100644
index 0000000..8c6e2fc
--- /dev/null
+++ b/lib/ui/theme.dart
@@ -0,0 +1,88 @@
+import 'package:flutter/material.dart';
+
+const ink = Color(0xFF1E1A17);
+const paper = Color(0xFFF3F0E8);
+const card = Color(0xFFFFFCF7);
+const line = Color(0xFFE4DDD2);
+const accent = Color(0xFF0F6E56);
+const transit = Color(0xFF3E5870);
+const layoverAmber = Color(0xFF8A5A00);
+const gapInk = Color(0xFF8C4A32);
+
+ThemeData buildTheme() {
+  final scheme = ColorScheme.fromSeed(
+    seedColor: accent,
+    brightness: Brightness.light,
+    surface: card,
+  );
+  return ThemeData(
+    useMaterial3: true,
+    colorScheme: scheme.copyWith(
+      primary: accent,
+      onPrimary: Colors.white,
+      surface: card,
+      onSurface: ink,
+    ),
+    scaffoldBackgroundColor: paper,
+    dividerColor: line,
+    appBarTheme: const AppBarTheme(
+      backgroundColor: paper,
+      foregroundColor: ink,
+      elevation: 0,
+      scrolledUnderElevation: 0,
+    ),
+    cardTheme: CardThemeData(
+      color: card,
+      elevation: 0,
+      shape: RoundedRectangleBorder(
+        borderRadius: BorderRadius.circular(18),
+        side: const BorderSide(color: line),
+      ),
+    ),
+    inputDecorationTheme: InputDecorationTheme(
+      filled: true,
+      fillColor: Colors.white,
+      border: OutlineInputBorder(
+        borderRadius: BorderRadius.circular(12),
+        borderSide: const BorderSide(color: line),
+      ),
+    ),
+    filledButtonTheme: FilledButtonThemeData(
+      style: FilledButton.styleFrom(
+        backgroundColor: accent,
+        foregroundColor: Colors.white,
+        padding: const EdgeInsets.symmetric(horizontal: 18, vertical: 14),
+        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
+      ),
+    ),
+    navigationRailTheme: const NavigationRailThemeData(
+      backgroundColor: paper,
+      selectedIconTheme: IconThemeData(color: accent),
+      indicatorColor: Color(0xFFDCE8E3),
+    ),
+  );
+}
+
+Color countryColor(String code) {
+  const palette = <int>[
+    0xFF0F6E56,
+    0xFF1D4E89,
+    0xFF8C4A32,
+    0xFF6B4C9A,
+    0xFFA15C07,
+    0xFF0F766E,
+    0xFF9F1239,
+    0xFF3F6212,
+    0xFF1E3A8A,
+    0xFF155E75,
+    0xFF7C2D12,
+    0xFF831843,
+    0xFF334155,
+    0xFF0E7490,
+    0xFF365314,
+    0xFF92400E,
+  ];
+  if (code.length < 2) return transit;
+  final index = (code.codeUnitAt(0) * 31 + code.codeUnitAt(1)) % palette.length;
+  return Color(palette[index]);
+}
diff --git a/lib/ui/transfer_page.dart b/lib/ui/transfer_page.dart
new file mode 100644
index 0000000..7dd1b87
--- /dev/null
+++ b/lib/ui/transfer_page.dart
@@ -0,0 +1,137 @@
+import 'package:flutter/foundation.dart';
+import 'package:flutter/material.dart';
+
+import '../engine/csv_codec.dart';
+import '../platform/csv_file.dart';
+import '../state/app_controller.dart';
+
+class TransferPage extends StatefulWidget {
+  const TransferPage({super.key, required this.controller});
+
+  final AppController controller;
+
+  @override
+  State<TransferPage> createState() => _TransferPageState();
+}
+
+class _TransferPageState extends State<TransferPage> {
+  final _csv = TextEditingController();
+  CsvImportPreview? _preview;
+  bool _allowExample = false;
+  String? _message;
+
+  @override
+  void dispose() {
+    _csv.dispose();
+    super.dispose();
+  }
+
+  void _parse(String raw) {
+    setState(() {
+      _preview = raw.trim().isEmpty ? null : CsvCodec.parse(raw);
+      _message = null;
+      _allowExample = false;
+    });
+  }
+
+  Future<void> _import() async {
+    final preview = _preview;
+    if (preview == null) return;
+    final failure = await widget.controller.importRows(
+      preview,
+      allowExampleIntoConnected: _allowExample,
+    );
+    if (!mounted) return;
+    setState(() => _message = failure ?? 'Import finished.');
+  }
+
+  Future<void> _export() async {
+    final contents = widget.controller.exportCsv();
+    if (kIsWeb) {
+      await downloadTextFile(widget.controller.exportFilename(), contents);
+      return;
+    }
+    setState(() {
+      _csv.text = contents;
+      _message = 'The export is in the text box.';
+    });
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final preview = _preview;
+    return ListView(
+      padding: const EdgeInsets.fromLTRB(20, 8, 20, 32),
+      children: [
+        Text(
+          'Import and export',
+          style: Theme.of(context).textTheme.headlineSmall,
+        ),
+        const SizedBox(height: 8),
+        const Text(
+          'The sheet uses one header. record_type is stay, flight, or meta. Import adds rows and updates a row only when its external id already exists. It does not delete anything.',
+        ),
+        const SizedBox(height: 12),
+        Wrap(
+          spacing: 8,
+          runSpacing: 8,
+          children: [
+            FilledButton(onPressed: _export, child: const Text('Export CSV')),
+            if (kIsWeb)
+              OutlinedButton(
+                onPressed: () async {
+                  final text = await pickTextFile();
+                  if (text == null) return;
+                  _csv.text = text;
+                  _parse(text);
+                },
+                child: const Text('Choose a file'),
+              ),
+          ],
+        ),
+        const SizedBox(height: 12),
+        TextField(
+          controller: _csv,
+          minLines: 8,
+          maxLines: 16,
+          decoration: const InputDecoration(
+            labelText: 'CSV',
+            alignLabelWithHint: true,
+          ),
+          onChanged: _parse,
+        ),
+        const SizedBox(height: 12),
+        if (preview != null) ...[
+          Text(
+            '${preview.stays.length} stays, ${preview.flights.length} flights, ${preview.errors.length} row errors.',
+          ),
+          if (preview.exampleDataset)
+            CheckboxListTile(
+              contentPadding: EdgeInsets.zero,
+              value: _allowExample,
+              onChanged: widget.controller.isConnected
+                  ? (value) => setState(() => _allowExample = value ?? false)
+                  : null,
+              title: const Text('This file is labeled EXAMPLE DATASET'),
+              subtitle: Text(
+                widget.controller.isConnected
+                    ? 'Check this to copy those fictional rows into the connected database.'
+                    : 'Example mode can import it without copying it to PocketBase.',
+              ),
+            ),
+          for (final error in preview.errors.take(8))
+            Text(
+              error,
+              style: TextStyle(color: Theme.of(context).colorScheme.error),
+            ),
+          const SizedBox(height: 8),
+          FilledButton(
+            onPressed: preview.hasRows ? _import : null,
+            child: const Text('Import valid rows'),
+          ),
+        ],
+        if (_message != null) ...[const SizedBox(height: 12), Text(_message!)],
+      ],
+    );
+  }
+}
diff --git a/pb_migrations/1794136000_create_travel_collections.js b/pb_migrations/1794136000_create_travel_collections.js
new file mode 100644
index 0000000..39e0e40
--- /dev/null
+++ b/pb_migrations/1794136000_create_travel_collections.js
@@ -0,0 +1,198 @@
+/// Additive travel schema for one PocketBase instance (one SQLite file).
+///
+/// Creates stays, flights, and counting_settings only when those names are
+/// absent. It does not change the users collection, existing collections,
+/// fields, or records.
+///
+/// The down function deletes those three collections. Do not run
+/// `migrate down` on a database that holds records you need, including
+/// https://nomad.pockethost.io.
+
+migrate(
+  (app) => {
+    const users = app.findCollectionByNameOrId("users");
+
+    if (!findOptional(app, "stays")) {
+      app.save(
+        new Collection({
+          type: "base",
+          name: "stays",
+          listRule: '@request.auth.id != "" && user = @request.auth.id',
+          viewRule: '@request.auth.id != "" && user = @request.auth.id',
+          createRule:
+            '@request.auth.id != "" && @request.body.user = @request.auth.id',
+          updateRule:
+            '@request.auth.id != "" && user = @request.auth.id && @request.body.user = @request.auth.id',
+          deleteRule: '@request.auth.id != "" && user = @request.auth.id',
+          fields: [
+            relation(users.id, "user"),
+            text("country_code", false, 0, 2),
+            text("start_date", true, 10, 10),
+            text("end_date", true, 10, 10),
+            select("role", [
+              "primary",
+              "layover",
+              "transit_wake",
+              "transit_night",
+            ]),
+            text("evidence_status", true, 1, 40),
+            select("inference", [
+              "none",
+              "inferred_itinerary",
+              "inferred_connection",
+              "inferred_gap",
+            ]),
+            select("phase", ["actual", "planned"]),
+            text("timezone", true, 1, 64),
+            text("notes", false, 0, 2000),
+            text("external_id", false, 0, 80),
+            select("source", ["manual", "csv", "flight_review"]),
+          ],
+          indexes: [
+            "CREATE INDEX idx_stays_user_start ON stays (user, start_date)",
+          ],
+        }),
+      );
+    }
+
+    if (!findOptional(app, "flights")) {
+      app.save(
+        new Collection({
+          type: "base",
+          name: "flights",
+          listRule: '@request.auth.id != "" && user = @request.auth.id',
+          viewRule: '@request.auth.id != "" && user = @request.auth.id',
+          createRule:
+            '@request.auth.id != "" && @request.body.user = @request.auth.id',
+          updateRule:
+            '@request.auth.id != "" && user = @request.auth.id && @request.body.user = @request.auth.id',
+          deleteRule: '@request.auth.id != "" && user = @request.auth.id',
+          fields: [
+            relation(users.id, "user"),
+            text("flight_number", true, 2, 8),
+            text("from_iata", true, 3, 3),
+            text("to_iata", true, 3, 3),
+            text("from_country", true, 2, 2),
+            text("to_country", true, 2, 2),
+            text("depart_local", true, 16, 16),
+            text("arrive_local", true, 16, 16),
+            text("depart_timezone", true, 1, 64),
+            text("arrive_timezone", true, 1, 64),
+            text("evidence_status", true, 1, 40),
+            select("inference", [
+              "none",
+              "inferred_itinerary",
+              "inferred_connection",
+              "inferred_gap",
+            ]),
+            select("review_state", [
+              "pending",
+              "accepted",
+              "rejected",
+              "needs_manual",
+            ]),
+            text("notes", false, 0, 2000),
+            text("external_id", false, 0, 80),
+          ],
+          indexes: [
+            "CREATE INDEX idx_flights_user_depart ON flights (user, depart_local)",
+          ],
+        }),
+      );
+    }
+
+    if (!findOptional(app, "counting_settings")) {
+      app.save(
+        new Collection({
+          type: "base",
+          name: "counting_settings",
+          listRule: '@request.auth.id != "" && user = @request.auth.id',
+          viewRule: '@request.auth.id != "" && user = @request.auth.id',
+          createRule:
+            '@request.auth.id != "" && @request.body.user = @request.auth.id',
+          updateRule:
+            '@request.auth.id != "" && user = @request.auth.id && @request.body.user = @request.auth.id',
+          deleteRule: '@request.auth.id != "" && user = @request.auth.id',
+          fields: [
+            relation(users.id, "user"),
+            {
+              name: "wake_hour",
+              type: "number",
+              required: true,
+              min: 0,
+              max: 23,
+              onlyInt: true,
+            },
+            {
+              name: "wake_minute",
+              type: "number",
+              required: true,
+              min: 0,
+              max: 59,
+              onlyInt: true,
+            },
+            { name: "include_inferred", type: "bool", required: false },
+            {
+              name: "personal_day_marker",
+              type: "number",
+              required: false,
+              min: 0,
+              max: 366,
+              onlyInt: true,
+            },
+            text("statuses_json", true, 2, 8000),
+          ],
+          indexes: [
+            "CREATE UNIQUE INDEX idx_counting_settings_user ON counting_settings (user)",
+          ],
+        }),
+      );
+    }
+  },
+  (app) => {
+    // Destructive. Do not run against a database you need to keep.
+    for (const name of ["stays", "flights", "counting_settings"]) {
+      const collection = findOptional(app, name);
+      if (collection) app.delete(collection);
+    }
+  },
+);
+
+function findOptional(app, name) {
+  try {
+    return app.findCollectionByNameOrId(name);
+  } catch (err) {
+    return null;
+  }
+}
+
+function relation(usersId, name) {
+  return {
+    name: name,
+    type: "relation",
+    required: true,
+    collectionId: usersId,
+    cascadeDelete: true,
+    maxSelect: 1,
+  };
+}
+
+function text(name, required, min, max) {
+  return {
+    name: name,
+    type: "text",
+    required: required,
+    min: min,
+    max: max,
+  };
+}
+
+function select(name, values) {
+  return {
+    name: name,
+    type: "select",
+    required: true,
+    maxSelect: 1,
+    values: values,
+  };
+}
