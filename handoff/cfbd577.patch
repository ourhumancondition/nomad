diff --git a/scripts/vercel_build_web.sh b/scripts/vercel_build_web.sh
new file mode 100755
index 0000000..8fb643d
--- /dev/null
+++ b/scripts/vercel_build_web.sh
@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+# Builds the Flutter web release for Vercel.
+# Vercel hosts this static bundle only. PocketBase stays on PocketHost.
+# Local loopback databases are not enabled in this build.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+
+FLUTTER_VERSION="${FLUTTER_VERSION:-3.47.9}"
+FLUTTER_ROOT="${FLUTTER_ROOT:-"$HOME/flutter-$FLUTTER_VERSION"}"
+
+if ! command -v flutter >/dev/null 2>&1; then
+  if [[ ! -x "$FLUTTER_ROOT/bin/flutter" ]]; then
+    mkdir -p "$(dirname "$FLUTTER_ROOT")"
+    tmp="$(mktemp)"
+    curl -fL "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz" -o "$tmp"
+    mkdir -p "$FLUTTER_ROOT"
+    tar -C "$(dirname "$FLUTTER_ROOT")" -xf "$tmp"
+    rm -f "$tmp"
+    if [[ "$(dirname "$FLUTTER_ROOT")/flutter" != "$FLUTTER_ROOT" ]]; then
+      rm -rf "$FLUTTER_ROOT"
+      mv "$(dirname "$FLUTTER_ROOT")/flutter" "$FLUTTER_ROOT"
+    fi
+  fi
+  export PATH="$FLUTTER_ROOT/bin:$PATH"
+fi
+
+flutter config --enable-web --no-analytics
+flutter pub get
+flutter build web --release --base-href /
diff --git a/test/csv_and_endpoint_test.dart b/test/csv_and_endpoint_test.dart
new file mode 100644
index 0000000..51174ec
--- /dev/null
+++ b/test/csv_and_endpoint_test.dart
@@ -0,0 +1,98 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:nomadic_residence/data/instance_endpoint.dart';
+import 'package:nomadic_residence/demo/example_dataset.dart';
+import 'package:nomadic_residence/engine/csv_codec.dart';
+import 'package:nomadic_residence/engine/models.dart';
+
+void main() {
+  test('csv round-trips the example and labels it', () {
+    final dataset = buildExampleDataset();
+    final raw = CsvCodec.encode(
+      stays: dataset.stays,
+      flights: dataset.flights,
+      exampleDataset: true,
+    );
+    expect(raw.startsWith(csvColumns.join(',')), isTrue);
+    expect(raw.contains('EXAMPLE DATASET'), isTrue);
+    final preview = CsvCodec.parse(raw);
+    expect(preview.errors, isEmpty);
+    expect(preview.exampleDataset, isTrue);
+    expect(preview.stays, hasLength(dataset.stays.length));
+    expect(preview.flights, hasLength(dataset.flights.length));
+    expect(
+      preview.stays.map((stay) => stay.externalId),
+      containsAll(dataset.stays.map((stay) => stay.externalId)),
+    );
+    final leap = preview.stays.singleWhere(
+      (stay) => stay.externalId == 'example-is',
+    );
+    expect(leap.start.iso, '2024-02-28');
+    expect(leap.end.iso, '2024-03-02');
+  });
+
+  test('quoted commas and a bad date are reported without dropping the good row', () {
+    final header = csvColumns.join(',');
+    const good =
+        'stay,sheet-1,PT,2026-01-01,2026-01-02,primary,confirmed,none,actual,Europe/Lisbon,"Lisbon, example",,,,,,,,,,';
+    const bad =
+        'stay,sheet-2,PT,2026-02-31,2026-03-01,primary,confirmed,none,actual,Europe/Lisbon,bad,,,,,,,,,,';
+    final preview = CsvCodec.parse('$header\n$good\n$bad\n');
+    expect(preview.exampleDataset, isFalse);
+    expect(preview.stays, hasLength(1));
+    expect(preview.stays.single.notes, 'Lisbon, example');
+    expect(preview.errors, hasLength(1));
+  });
+
+  test('allowlisted PocketHost origins are the only remote targets', () {
+    InstanceEndpoint parse(String raw, {bool allowLocal = false}) {
+      return InstanceEndpoint.parse(raw, allowLocal: allowLocal);
+    }
+
+    expect(
+      parse('https://nomad.pockethost.io').origin.toString(),
+      'https://nomad.pockethost.io',
+    );
+    expect(
+      parse('https://nomad.pockethost.io/').healthUri.toString(),
+      'https://nomad.pockethost.io/api/health',
+    );
+    expect(parse('https://AB.pockethost.io').displayHost, 'ab.pockethost.io');
+    expect(
+      parse('http://127.0.0.1:18091', allowLocal: true).origin.toString(),
+      'http://127.0.0.1:18091',
+    );
+    expect(parse('http://localhost:8090/', allowLocal: true).loopback, isTrue);
+
+    final rejected = <String>[
+      'nomad.pockethost.io',
+      'http://nomad.pockethost.io',
+      'https://nomad.pockethost.io/api',
+      'https://nomad.pockethost.io?x=1',
+      'https://user:pass@nomad.pockethost.io',
+      'https://nomad.pockethost.io.evil.com',
+      'https://evil.com',
+      'https://pockethost.io',
+      'https://a.b.pockethost.io',
+      'https://-bad.pockethost.io',
+      'https://169.254.169.254/',
+      'http://169.254.169.254/',
+      'http://10.0.0.1/',
+      'https://127.0.0.1:8090',
+      'http://127.0.0.1:8090',
+      'file:///etc/passwd',
+      'javascript:alert(1)',
+    ];
+    for (final raw in rejected) {
+      expect(
+        InstanceEndpoint.tryParse(raw, allowLocal: false),
+        isNull,
+        reason: raw,
+      );
+    }
+  });
+
+  test('default rules do not embed a day threshold', () {
+    expect(CountingRules.standard.personalDayMarker, isNull);
+    expect(lockedRuleStatements.any((line) => line.contains('183')), isFalse);
+  });
+}
diff --git a/test/day_engine_test.dart b/test/day_engine_test.dart
new file mode 100644
index 0000000..e933bfd
--- /dev/null
+++ b/test/day_engine_test.dart
@@ -0,0 +1,272 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:nomadic_residence/demo/example_dataset.dart';
+import 'package:nomadic_residence/engine/day_engine.dart';
+import 'package:nomadic_residence/engine/local_date.dart';
+import 'package:nomadic_residence/engine/models.dart';
+
+void main() {
+  const rules = CountingRules.standard;
+  final statuses = defaultEvidenceStatuses;
+  final today = LocalDate(2026, 11, 8);
+
+  Stay stay({
+    required String country,
+    required String start,
+    required String end,
+    PresenceRole role = PresenceRole.primary,
+    String evidence = 'confirmed',
+    InferenceKind inference = InferenceKind.none,
+    TripPhase phase = TripPhase.actual,
+  }) {
+    return Stay(
+      id: '$country-$start',
+      countryCode: country,
+      start: LocalDate.parse(start),
+      end: LocalDate.parse(end),
+      role: role,
+      evidenceStatus: evidence,
+      inference: inference,
+      phase: phase,
+      timezone: 'Etc/UTC',
+    );
+  }
+
+  YearTally count(
+    List<Stay> stays, {
+    int year = 2026,
+    LocalDate? asOf,
+    CountingRules? counting,
+    List<EvidenceStatusDef>? statusList,
+  }) {
+    return DayEngine.tally(
+      stays: stays,
+      year: year,
+      today: asOf ?? today,
+      rules: counting ?? rules,
+      statuses: statusList ?? statuses,
+    );
+  }
+
+  test('the example dataset matches the hand-checked 2026 window', () {
+    final dataset = buildExampleDataset();
+    final tally = count(dataset.stays);
+    expect(tally.windowLength, 312);
+    expect(tally.daysInYear, 365);
+    expect(tally.primaryDays['PT'], 90);
+    expect(tally.primaryDays['JP'], 6);
+    expect(tally.primaryDays['SG'], 71);
+    expect(tally.primaryDays['GR'], 4);
+    expect(tally.primaryDays['IT'], 2);
+    expect(tally.primaryDays['MX'], 39);
+    expect(tally.primaryDays.containsKey('FR'), isFalse);
+    expect(tally.primaryDays.containsKey('NZ'), isFalse);
+    expect(tally.primaryDays.containsKey('CL'), isFalse);
+    expect(tally.primaryCountryDays, 212);
+    expect(tally.overlapDays, 6);
+    expect(tally.transitWakeDays, 1);
+    expect(tally.gapDays, 93);
+    expect(tally.layoverDays['QA'], 1);
+    expect(tally.overnightNights, 1);
+    expect(tally.identityHolds, isTrue);
+    expect(
+      tally.primaryCountryDays +
+          tally.layoverDays.values.fold<int>(0, (a, b) => a + b),
+      isNot(tally.windowLength),
+    );
+  });
+
+  test('2024 keeps the leap day inside Iceland', () {
+    final dataset = buildExampleDataset();
+    final tally = count(dataset.stays, year: 2024, asOf: today);
+    expect(tally.daysInYear, 366);
+    expect(tally.windowLength, 366);
+    expect(tally.primaryDays['IS'], 4);
+    final leap = tally.days.singleWhere(
+      (day) => day.date == LocalDate(2024, 2, 29),
+    );
+    expect(leap.kind, DayKind.primaryCountry);
+    expect(leap.primaryCountry, 'IS');
+    expect(tally.identityHolds, isTrue);
+  });
+
+  test('a year boundary splits one stay without moving the dates', () {
+    final rows = [stay(country: 'PT', start: '2025-12-30', end: '2026-01-02')];
+    final previous = count(rows, year: 2025, asOf: today);
+    final current = count(rows, year: 2026, asOf: today);
+    expect(previous.primaryDays['PT'], 2);
+    expect(current.primaryDays['PT'], 2);
+    expect(previous.identityHolds, isTrue);
+    expect(current.identityHolds, isTrue);
+  });
+
+  test('two wake-up countries on one date stay unresolved', () {
+    final tally = count([
+      stay(country: 'GR', start: '2026-07-01', end: '2026-07-03'),
+      stay(country: 'IT', start: '2026-07-02', end: '2026-07-04'),
+    ]);
+    expect(tally.primaryDays['GR'], 1);
+    expect(tally.primaryDays['IT'], 1);
+    expect(tally.overlapDays, 2);
+    expect(tally.overlapSpans.single.countries, ['GR', 'IT']);
+    expect(tally.identityHolds, isTrue);
+  });
+
+  test(
+    'a layover is recorded separately and does not take the wake-up day',
+    () {
+      final tally = count([
+        stay(country: 'SG', start: '2026-05-02', end: '2026-05-02'),
+        stay(
+          country: 'QA',
+          start: '2026-05-02',
+          end: '2026-05-02',
+          role: PresenceRole.layover,
+        ),
+      ]);
+      expect(tally.primaryDays['SG'], 1);
+      expect(tally.primaryDays.containsKey('QA'), isFalse);
+      expect(tally.layoverDays['QA'], 1);
+      final day = tally.days.singleWhere(
+        (item) => item.date == LocalDate(2026, 5, 2),
+      );
+      expect(day.kind, DayKind.primaryCountry);
+      expect(day.layoverCountries, ['QA']);
+    },
+  );
+
+  test(
+    'overnight nights do not consume the wake-up day, airborne wake-ups do',
+    () {
+      final tally = count([
+        stay(country: 'JP', start: '2026-04-20', end: '2026-04-20'),
+        stay(
+          country: '',
+          start: '2026-04-20',
+          end: '2026-04-20',
+          role: PresenceRole.transitNight,
+        ),
+        stay(
+          country: '',
+          start: '2026-04-21',
+          end: '2026-04-21',
+          role: PresenceRole.transitWake,
+        ),
+      ]);
+      expect(tally.primaryDays['JP'], 1);
+      expect(tally.overnightNights, 1);
+      expect(tally.transitWakeDays, 1);
+      expect(tally.identityHolds, isTrue);
+    },
+  );
+
+  test('booking-only, inference, planned, and future dates stay out', () {
+    final tally = count([
+      stay(
+        country: 'FR',
+        start: '2026-08-01',
+        end: '2026-08-02',
+        evidence: 'booking_only',
+      ),
+      stay(
+        country: 'FR',
+        start: '2026-08-03',
+        end: '2026-08-03',
+        inference: InferenceKind.inferredItinerary,
+      ),
+      stay(
+        country: 'NZ',
+        start: '2026-12-20',
+        end: '2026-12-22',
+        phase: TripPhase.planned,
+      ),
+      stay(country: 'CL', start: '2026-12-01', end: '2026-12-02'),
+    ]);
+    expect(tally.primaryCountryDays, 0);
+    expect(tally.excluded, hasLength(2));
+    expect(tally.planned, hasLength(1));
+    expect(tally.futureActual, hasLength(1));
+    expect(tally.gapDays, tally.windowLength);
+  });
+
+  test('an unknown status fails closed and a traveler status can count', () {
+    final unknown = count([
+      stay(
+        country: 'PT',
+        start: '2026-01-01',
+        end: '2026-01-01',
+        evidence: 'passport_stamp',
+      ),
+    ]);
+    expect(unknown.primaryCountryDays, 0);
+    final custom = defaultEvidenceStatuses.followedBy([
+      const EvidenceStatusDef(
+        id: 'passport_stamp',
+        label: 'Passport stamp',
+        countsAsActual: true,
+      ),
+    ]).toList();
+    final counted = count([
+      stay(
+        country: 'PT',
+        start: '2026-01-01',
+        end: '2026-01-01',
+        evidence: 'passport_stamp',
+      ),
+    ], statusList: custom);
+    expect(counted.primaryDays['PT'], 1);
+  });
+
+  test('opting in to inferences counts them and still skips booking only', () {
+    final rows = [
+      stay(
+        country: 'FR',
+        start: '2026-08-21',
+        end: '2026-08-21',
+        inference: InferenceKind.inferredItinerary,
+      ),
+      stay(
+        country: 'FR',
+        start: '2026-08-22',
+        end: '2026-08-22',
+        evidence: 'booking_only',
+      ),
+    ];
+    final included = count(
+      rows,
+      counting: const CountingRules(includeInferred: true),
+    );
+    expect(included.primaryDays['FR'], 1);
+    expect(included.excluded.single.stay.evidenceStatus, 'booking_only');
+  });
+
+  test('today counts and tomorrow does not', () {
+    final tally = count([
+      stay(country: 'MX', start: '2026-11-08', end: '2026-11-09'),
+    ]);
+    expect(tally.primaryDays['MX'], 1);
+    final tomorrow = tally.days.singleWhere(
+      (day) => day.date == LocalDate(2026, 11, 9),
+    );
+    expect(tomorrow.kind, DayKind.future);
+  });
+
+  test('a gap between two stays is left empty', () {
+    final tally = count([
+      stay(country: 'PT', start: '2026-01-01', end: '2026-01-02'),
+      stay(country: 'PT', start: '2026-01-05', end: '2026-01-05'),
+    ]);
+    final gap = tally.days.singleWhere(
+      (day) => day.date == LocalDate(2026, 1, 3),
+    );
+    expect(gap.kind, DayKind.gap);
+    expect(
+      tally.gapRanges.any((range) => range.contains(LocalDate(2026, 1, 4))),
+      isTrue,
+    );
+  });
+
+  test('personal marker is unset by default', () {
+    expect(CountingRules.standard.personalDayMarker, isNull);
+    expect(CountingRules.standard.includeInferred, isFalse);
+  });
+}
diff --git a/test/flight_proposals_test.dart b/test/flight_proposals_test.dart
new file mode 100644
index 0000000..756a44e
--- /dev/null
+++ b/test/flight_proposals_test.dart
@@ -0,0 +1,181 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:nomadic_residence/engine/flight_proposals.dart';
+import 'package:nomadic_residence/engine/local_date.dart';
+import 'package:nomadic_residence/engine/models.dart';
+
+void main() {
+  const rules = CountingRules.standard;
+
+  FlightRecord flight({
+    required String id,
+    required String from,
+    required String to,
+    required String depart,
+    required String arrive,
+  }) {
+    return FlightRecord(
+      id: id,
+      flightNumber: 'EX100',
+      fromIata: 'AAA',
+      toIata: 'BBB',
+      fromCountry: from,
+      toCountry: to,
+      depart: WallTime.parse(depart),
+      arrive: WallTime.parse(arrive),
+      departTimezone: 'Etc/UTC',
+      arriveTimezone: 'Etc/UTC',
+      evidenceStatus: 'confirmed',
+      inference: InferenceKind.none,
+      reviewState: FlightReviewState.pending,
+    );
+  }
+
+  List<Stay> stays(List<FlightProposal> proposals, PresenceRole role) {
+    return proposals
+        .map((proposal) => proposal.stay)
+        .whereType<Stay>()
+        .where((stay) => stay.role == role)
+        .toList();
+  }
+
+  test('a short overnight flight marks the night and the arrival morning', () {
+    final proposals = proposeItinerary([
+      flight(
+        id: 'night',
+        from: 'JP',
+        to: 'SG',
+        depart: '2026-04-20T22:40',
+        arrive: '2026-04-21T04:10',
+      ),
+    ], rules);
+    final nights = stays(proposals, PresenceRole.transitNight);
+    final wakes = stays(proposals, PresenceRole.transitWake);
+    final primary = stays(proposals, PresenceRole.primary);
+    expect(nights.single.start, LocalDate(2026, 4, 20));
+    expect(nights.single.end, LocalDate(2026, 4, 20));
+    expect(wakes, isEmpty);
+    expect(primary.single.countryCode, 'SG');
+    expect(primary.single.start, LocalDate(2026, 4, 21));
+    expect(primary.single.end, LocalDate(2026, 4, 21));
+    expect(primary.single.evidenceStatus, 'inferred');
+    expect(primary.single.inference.isInference, isTrue);
+  });
+
+  test('a long flight makes full airborne wake-ups and does not claim the departure morning', () {
+    final proposals = proposeItinerary([
+      flight(
+        id: 'long',
+        from: 'PT',
+        to: 'NZ',
+        depart: '2026-05-01T10:00',
+        arrive: '2026-05-03T15:00',
+      ),
+    ], rules);
+    final wakes = stays(proposals, PresenceRole.transitWake).single;
+    expect(wakes.start, LocalDate(2026, 5, 2));
+    expect(wakes.end, LocalDate(2026, 5, 3));
+    final night = stays(proposals, PresenceRole.transitNight).single;
+    expect(night.start, LocalDate(2026, 5, 1));
+    expect(night.end, LocalDate(2026, 5, 2));
+    expect(
+      stays(proposals, PresenceRole.primary).single.start,
+      LocalDate(2026, 5, 4),
+    );
+  });
+
+  test('a same-day connection after wake time is a layover', () {
+    final proposals = proposeItinerary([
+      flight(
+        id: 'in',
+        from: 'SG',
+        to: 'QA',
+        depart: '2026-05-02T01:00',
+        arrive: '2026-05-02T10:00',
+      ),
+      flight(
+        id: 'out',
+        from: 'QA',
+        to: 'GB',
+        depart: '2026-05-02T12:00',
+        arrive: '2026-05-02T16:00',
+      ),
+    ], rules);
+    final layover = stays(proposals, PresenceRole.layover).single;
+    expect(layover.countryCode, 'QA');
+    expect(layover.start, LocalDate(2026, 5, 2));
+    expect(
+      stays(
+        proposals,
+        PresenceRole.primary,
+      ).where((stay) => stay.countryCode == 'QA'),
+      isEmpty,
+    );
+  });
+
+  test('waking up in the connection country is a main day', () {
+    final proposals = proposeItinerary([
+      flight(
+        id: 'in',
+        from: 'SG',
+        to: 'QA',
+        depart: '2026-05-02T01:00',
+        arrive: '2026-05-02T06:00',
+      ),
+      flight(
+        id: 'out',
+        from: 'QA',
+        to: 'GB',
+        depart: '2026-05-02T09:00',
+        arrive: '2026-05-02T14:00',
+      ),
+    ], rules);
+    final primary = stays(
+      proposals,
+      PresenceRole.primary,
+    ).singleWhere((stay) => stay.countryCode == 'QA');
+    expect(primary.inference, InferenceKind.inferredConnection);
+    expect(stays(proposals, PresenceRole.layover), isEmpty);
+  });
+
+  test('a multi-day hole between flights is not filled', () {
+    final proposals = proposeItinerary([
+      flight(
+        id: 'in',
+        from: 'PT',
+        to: 'JP',
+        depart: '2026-04-01T09:00',
+        arrive: '2026-04-01T18:00',
+      ),
+      flight(
+        id: 'out',
+        from: 'JP',
+        to: 'SG',
+        depart: '2026-04-20T09:00',
+        arrive: '2026-04-20T15:00',
+      ),
+    ], rules);
+    expect(
+      proposals.any((proposal) => proposal.reason.contains('stay unknown')),
+      isTrue,
+    );
+    final japan = stays(
+      proposals,
+      PresenceRole.primary,
+    ).where((stay) => stay.countryCode == 'JP');
+    expect(japan.single.start, japan.single.end);
+  });
+
+  test('a backward civil date is manual review and creates no stay', () {
+    final proposals = proposeItinerary([
+      flight(
+        id: 'back',
+        from: 'US',
+        to: 'WS',
+        depart: '2026-06-02T12:00',
+        arrive: '2026-06-01T18:00',
+      ),
+    ], rules);
+    expect(proposals.single.needsManualReview, isTrue);
+    expect(proposals.single.stay, isNull);
+  });
+}
