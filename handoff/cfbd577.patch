diff --git a/lib/state/app_controller.dart b/lib/state/app_controller.dart
new file mode 100644
index 0000000..5229a00
--- /dev/null
+++ b/lib/state/app_controller.dart
@@ -0,0 +1,487 @@
+import 'package:flutter/foundation.dart';
+
+import '../data/instance_endpoint.dart';
+import '../data/pocketbase_gateway.dart';
+import '../demo/example_dataset.dart';
+import '../engine/csv_codec.dart';
+import '../engine/day_engine.dart';
+import '../engine/flight_proposals.dart';
+import '../engine/local_date.dart';
+import '../engine/models.dart';
+
+enum SessionKind { unconfigured, example, connected }
+
+class AppController extends ChangeNotifier {
+  AppController({
+    LocalDate Function()? clock,
+    PocketBaseGateway? gateway,
+    bool? allowLocalEndpoints,
+  }) : clock = clock ?? LocalDate.todayDevice,
+       gateway = gateway ?? PocketBaseGateway(),
+       allowLocalEndpoints =
+           allowLocalEndpoints ??
+           (kDebugMode ||
+               const bool.fromEnvironment('ALLOW_LOCAL_POCKETBASE')) {
+    year = this.clock().year;
+  }
+
+  final LocalDate Function() clock;
+  final PocketBaseGateway gateway;
+  final bool allowLocalEndpoints;
+
+  SessionKind kind = SessionKind.unconfigured;
+  int year = 2026;
+  CountingRules rules = CountingRules.standard;
+  List<EvidenceStatusDef> statuses = List<EvidenceStatusDef>.of(
+    defaultEvidenceStatuses,
+  );
+  List<Stay> stays = [];
+  List<FlightRecord> flights = [];
+  String? accountEmail;
+  String? instanceOrigin;
+  InstanceEndpoint? pendingEndpoint;
+  String? statusMessage;
+  String? errorMessage;
+  bool busy = false;
+  int _sequence = 0;
+
+  bool get isExample => kind == SessionKind.example;
+  bool get isConnected => kind == SessionKind.connected;
+  bool get canEdit => kind != SessionKind.unconfigured;
+
+  YearTally get tally => DayEngine.tally(
+    stays: stays,
+    year: year,
+    today: clock(),
+    rules: rules,
+    statuses: statuses,
+  );
+
+  List<int> get years {
+    final values = <int>{year, clock().year};
+    for (final stay in stays) {
+      values.add(stay.start.year);
+      values.add(stay.end.year);
+    }
+    for (final flight in flights) {
+      values.add(flight.depart.date.year);
+      values.add(flight.arrive.date.year);
+    }
+    final sorted = values.toList()..sort((a, b) => b.compareTo(a));
+    return sorted;
+  }
+
+  void openExample() {
+    final dataset = buildExampleDataset();
+    kind = SessionKind.example;
+    stays = dataset.stays;
+    flights = dataset.flights;
+    rules = CountingRules.standard;
+    statuses = List<EvidenceStatusDef>.of(defaultEvidenceStatuses);
+    year = ExampleDataset.storyYear;
+    accountEmail = null;
+    pendingEndpoint = null;
+    errorMessage = null;
+    statusMessage = 'Example dataset. These fictional rows stay in this tab and are not sent to PocketBase.';
+    notifyListeners();
+  }
+
+  void leaveExample() {
+    if (kind != SessionKind.example) return;
+    kind = SessionKind.unconfigured;
+    stays = [];
+    flights = [];
+    rules = CountingRules.standard;
+    statuses = List<EvidenceStatusDef>.of(defaultEvidenceStatuses);
+    year = clock().year;
+    statusMessage = null;
+    notifyListeners();
+  }
+
+  Future<String?> checkHealth(String rawUrl) async {
+    final endpoint = InstanceEndpoint.tryParse(
+      rawUrl,
+      allowLocal: allowLocalEndpoints,
+    );
+    if (endpoint == null) {
+      try {
+        InstanceEndpoint.parse(rawUrl, allowLocal: allowLocalEndpoints);
+      } on FormatException catch (error) {
+        return error.message;
+      }
+      return 'That URL is not an allowed database origin.';
+    }
+    return _guard(() async {
+      await gateway.checkHealth(endpoint);
+      pendingEndpoint = endpoint;
+      errorMessage = null;
+      statusMessage =
+          'Health check passed for ${endpoint.displayHost}. Sign in to that database.';
+    });
+  }
+
+  Future<String?> signIn(String email, String password) {
+    final endpoint = pendingEndpoint;
+    if (endpoint == null) {
+      return Future.value('Check the database health before signing in.');
+    }
+    return _guard(() async {
+      final snapshot = await gateway.signIn(endpoint, email, password);
+      _applySnapshot(snapshot);
+    });
+  }
+
+  Future<String?> signUp(String email, String password) {
+    final endpoint = pendingEndpoint;
+    if (endpoint == null) {
+      return Future.value(
+        'Check the database health before creating an account.',
+      );
+    }
+    if (password.length < 8) {
+      return Future.value('Use a password of at least 8 characters.');
+    }
+    return _guard(() async {
+      final snapshot = await gateway.signUp(endpoint, email, password);
+      _applySnapshot(snapshot);
+    });
+  }
+
+  Future<void> restoreIfSaved() async {
+    final raw = gateway.savedOrigin();
+    if (raw == null || raw.isEmpty || kind == SessionKind.example) return;
+    final endpoint = InstanceEndpoint.tryParse(
+      raw,
+      allowLocal: allowLocalEndpoints,
+    );
+    if (endpoint == null) {
+      gateway.forgetOrigin();
+      errorMessage =
+          'The saved database URL is not allowlisted, so it was forgotten.';
+      notifyListeners();
+      return;
+    }
+    final failure = await _guard(() async {
+      final snapshot = await gateway.restore(endpoint);
+      if (snapshot == null) {
+        pendingEndpoint = endpoint;
+        statusMessage =
+            '${endpoint.displayHost} is healthy. Sign in to open that database.';
+        return;
+      }
+      _applySnapshot(snapshot);
+    });
+    if (failure != null) {
+      errorMessage = failure;
+      notifyListeners();
+    }
+  }
+
+  void signOut() {
+    gateway.signOut();
+    kind = SessionKind.unconfigured;
+    stays = [];
+    flights = [];
+    accountEmail = null;
+    instanceOrigin = null;
+    pendingEndpoint = null;
+    rules = CountingRules.standard;
+    statuses = List<EvidenceStatusDef>.of(defaultEvidenceStatuses);
+    year = clock().year;
+    statusMessage = 'Signed out. No travel database is open.';
+    notifyListeners();
+  }
+
+  void setYear(int value) {
+    year = value;
+    notifyListeners();
+  }
+
+  Future<String?> saveStay(Stay stay) {
+    final problem = validateStay(stay);
+    if (problem != null) return Future.value(problem);
+    if (!canEdit) {
+      return Future.value(
+        'Open the example dataset or a per-user database before saving.',
+      );
+    }
+    if (kind == SessionKind.example) {
+      final index = stays.indexWhere((item) => item.id == stay.id);
+      if (index >= 0) {
+        stays = [...stays]..[index] = stay;
+      } else {
+        stays = [...stays, stay.copyWith(id: _id('stay'))];
+      }
+      notifyListeners();
+      return Future.value();
+    }
+    return _guard(() async {
+      final index = stays.indexWhere((item) => item.id == stay.id);
+      final saved = index >= 0
+          ? await gateway.updateStay(stay)
+          : await gateway.createStay(stay);
+      if (index >= 0) {
+        stays = [...stays]..[index] = saved;
+      } else {
+        stays = [...stays, saved];
+      }
+    });
+  }
+
+  Future<String?> deleteStay(String id) {
+    if (kind == SessionKind.example) {
+      stays = stays.where((stay) => stay.id != id).toList();
+      notifyListeners();
+      return Future.value();
+    }
+    if (!isConnected) {
+      return Future.value('No per-user database is open.');
+    }
+    return _guard(() async {
+      await gateway.deleteStay(id);
+      stays = stays.where((stay) => stay.id != id).toList();
+    });
+  }
+
+  Future<String?> saveFlight(FlightRecord flight) {
+    final problem = validateFlight(flight);
+    if (problem != null) return Future.value(problem);
+    if (!canEdit) {
+      return Future.value(
+        'Open the example dataset or a per-user database before saving.',
+      );
+    }
+    if (kind == SessionKind.example) {
+      final index = flights.indexWhere((item) => item.id == flight.id);
+      if (index >= 0) {
+        flights = [...flights]..[index] = flight;
+      } else {
+        flights = [...flights, flight.copyWith(id: _id('flight'))];
+      }
+      notifyListeners();
+      return Future.value();
+    }
+    return _guard(() async {
+      final index = flights.indexWhere((item) => item.id == flight.id);
+      final saved = index >= 0
+          ? await gateway.updateFlight(flight)
+          : await gateway.createFlight(flight);
+      if (index >= 0) {
+        flights = [...flights]..[index] = saved;
+      } else {
+        flights = [...flights, saved];
+      }
+    });
+  }
+
+  Future<String?> deleteFlight(String id) {
+    if (kind == SessionKind.example) {
+      flights = flights.where((flight) => flight.id != id).toList();
+      notifyListeners();
+      return Future.value();
+    }
+    if (!isConnected) return Future.value('No per-user database is open.');
+    return _guard(() async {
+      await gateway.deleteFlight(id);
+      flights = flights.where((flight) => flight.id != id).toList();
+    });
+  }
+
+  Future<String?> acceptFlight(
+    FlightRecord flight, {
+    required bool keepInference,
+    required bool presenceConfirmedDespiteBooking,
+  }) async {
+    if (flight.evidenceStatus == 'booking_only' &&
+        !presenceConfirmedDespiteBooking) {
+      return 'This flight is booking only. Confirm that you are recording presence before adding it to the calendar.';
+    }
+    final proposals = proposeItinerary([flight], rules);
+    final concrete = proposals
+        .where((proposal) => proposal.stay != null)
+        .toList();
+    if (concrete.isEmpty) {
+      final manual = proposals.where((proposal) => proposal.needsManualReview);
+      final updated = flight.copyWith(
+        reviewState: FlightReviewState.needsManual,
+        notes: flight.notes,
+      );
+      final failure = await saveFlight(updated);
+      if (failure != null) return failure;
+      return manual.isEmpty
+          ? 'This flight did not produce a stay. Add the wake-up country yourself.'
+          : manual.first.reason;
+    }
+    for (final proposal in concrete) {
+      var stay = proposal.stay!;
+      if (keepInference) {
+        stay = stay.copyWith(evidenceStatus: 'confirmed');
+      } else {
+        stay = stay.copyWith(
+          evidenceStatus: 'confirmed',
+          inference: InferenceKind.none,
+        );
+      }
+      stay = stay.copyWith(id: '', notes: _acceptanceNote(flight, stay.notes));
+      final failure = await saveStay(stay);
+      if (failure != null) return failure;
+    }
+    final needsManual = proposals.any((proposal) => proposal.needsManualReview);
+    return saveFlight(
+      flight.copyWith(
+        reviewState: needsManual
+            ? FlightReviewState.needsManual
+            : FlightReviewState.accepted,
+      ),
+    );
+  }
+
+  Future<String?> rejectFlight(FlightRecord flight) {
+    return saveFlight(flight.copyWith(reviewState: FlightReviewState.rejected));
+  }
+
+  Future<String?> saveRules({
+    required CountingRules nextRules,
+    required List<EvidenceStatusDef> nextStatuses,
+  }) {
+    if (nextStatuses.isEmpty) {
+      return Future.value('Keep at least one evidence status.');
+    }
+    final ids = nextStatuses.map((status) => status.id).toSet();
+    if (ids.length != nextStatuses.length) {
+      return Future.value('Evidence status ids must be unique.');
+    }
+    if (kind == SessionKind.example || kind == SessionKind.unconfigured) {
+      if (kind == SessionKind.unconfigured) {
+        return Future.value(
+          'Open the example dataset or a database before saving rules.',
+        );
+      }
+      rules = nextRules;
+      statuses = nextStatuses;
+      notifyListeners();
+      return Future.value();
+    }
+    return _guard(() async {
+      await gateway.saveSettings(rules: nextRules, statuses: nextStatuses);
+      rules = nextRules;
+      statuses = nextStatuses;
+    });
+  }
+
+  Future<String?> importRows(
+    CsvImportPreview preview, {
+    required bool allowExampleIntoConnected,
+  }) async {
+    if (!canEdit) {
+      return 'Open the example dataset or a per-user database before importing.';
+    }
+    if (preview.exampleDataset && isConnected && !allowExampleIntoConnected) {
+      return 'This file is labeled EXAMPLE DATASET. Confirm that you want it copied into this database.';
+    }
+    if (!preview.hasRows) {
+      return preview.errors.isEmpty
+          ? 'The file has no stay or flight rows.'
+          : preview.errors.first;
+    }
+    for (final stay in preview.stays) {
+      final existing = _stayByExternalId(stay.externalId);
+      final failure = await saveStay(
+        existing == null
+            ? stay.copyWith(id: '')
+            : stay.copyWith(id: existing.id),
+      );
+      if (failure != null) return failure;
+    }
+    for (final flight in preview.flights) {
+      final existing = _flightByExternalId(flight.externalId);
+      final failure = await saveFlight(
+        existing == null
+            ? flight.copyWith(id: '')
+            : flight.copyWith(id: existing.id),
+      );
+      if (failure != null) return failure;
+    }
+    statusMessage = preview.exampleDataset
+        ? 'Imported rows from a file labeled EXAMPLE DATASET.'
+        : 'Imported ${preview.stays.length} stays and ${preview.flights.length} flights. Existing rows were left in place except where an external id matched.';
+    notifyListeners();
+    return null;
+  }
+
+  String exportCsv() => CsvCodec.encode(
+    stays: stays,
+    flights: flights,
+    exampleDataset: isExample,
+  );
+
+  String exportFilename() => isExample
+      ? 'nomadic-residence-EXAMPLE-dataset.csv'
+      : 'nomadic-residence-export.csv';
+
+  List<FlightProposal> proposalsFor(FlightRecord flight) =>
+      proposeItinerary([flight], rules);
+
+  Stay? _stayByExternalId(String externalId) {
+    if (externalId.isEmpty) return null;
+    for (final stay in stays) {
+      if (stay.externalId == externalId) return stay;
+    }
+    return null;
+  }
+
+  FlightRecord? _flightByExternalId(String externalId) {
+    if (externalId.isEmpty) return null;
+    for (final flight in flights) {
+      if (flight.externalId == externalId) return flight;
+    }
+    return null;
+  }
+
+  void _applySnapshot(TravelSnapshot snapshot) {
+    kind = SessionKind.connected;
+    stays = snapshot.stays;
+    flights = snapshot.flights;
+    rules = snapshot.rules;
+    statuses = snapshot.statuses;
+    accountEmail = snapshot.email;
+    instanceOrigin = snapshot.origin;
+    year = clock().year;
+    errorMessage = null;
+    statusMessage = snapshot.warnings.isEmpty
+        ? 'Connected to ${Uri.parse(snapshot.origin).host} as ${snapshot.email}. This database should hold one traveler.'
+        : snapshot.warnings.join(' ');
+  }
+
+  Future<String?> _guard(Future<void> Function() action) async {
+    busy = true;
+    errorMessage = null;
+    notifyListeners();
+    try {
+      await action();
+      busy = false;
+      notifyListeners();
+      return null;
+    } catch (error) {
+      busy = false;
+      final message = error is GatewayException
+          ? error.message
+          : 'The database could not be reached.';
+      errorMessage = message;
+      notifyListeners();
+      return message;
+    }
+  }
+
+  String _id(String prefix) {
+    _sequence += 1;
+    return '$prefix-${clock().iso}-$_sequence';
+  }
+
+  String _acceptanceNote(FlightRecord flight, String proposalNote) {
+    final booking = flight.evidenceStatus == 'booking_only'
+        ? ' Accepted from booking-only flight ${flight.flightNumber} after an explicit presence confirmation.'
+        : ' Accepted from flight ${flight.flightNumber}.';
+    return '$proposalNote$booking';
+  }
+}
diff --git a/lib/ui/calendar_page.dart b/lib/ui/calendar_page.dart
new file mode 100644
index 0000000..f071444
--- /dev/null
+++ b/lib/ui/calendar_page.dart
@@ -0,0 +1,282 @@
+import 'package:flutter/material.dart';
+
+import '../data/countries.dart';
+import '../engine/day_engine.dart';
+import '../engine/local_date.dart';
+import '../state/app_controller.dart';
+import 'format.dart';
+import 'theme.dart';
+
+class CalendarPage extends StatefulWidget {
+  const CalendarPage({super.key, required this.controller});
+
+  final AppController controller;
+
+  @override
+  State<CalendarPage> createState() => _CalendarPageState();
+}
+
+class _CalendarPageState extends State<CalendarPage> {
+  late int month;
+
+  @override
+  void initState() {
+    super.initState();
+    final today = widget.controller.clock();
+    month = today.year == widget.controller.year ? today.month : 1;
+  }
+
+  @override
+  void didUpdateWidget(CalendarPage oldWidget) {
+    super.didUpdateWidget(oldWidget);
+    if (oldWidget.controller.year != widget.controller.year) {
+      final today = widget.controller.clock();
+      month = today.year == widget.controller.year ? today.month : 1;
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final tally = widget.controller.tally;
+    final byDate = {for (final day in tally.days) day.date: day};
+    final first = LocalDate(widget.controller.year, month, 1);
+    final leading = first.weekday - 1;
+    final days = LocalDate.daysInMonth(widget.controller.year, month);
+    return ListView(
+      padding: const EdgeInsets.fromLTRB(20, 8, 20, 32),
+      children: [
+        Row(
+          children: [
+            IconButton(
+              onPressed: month == 1 ? null : () => setState(() => month -= 1),
+              icon: const Icon(Icons.chevron_left),
+            ),
+            Expanded(
+              child: Text(
+                '${monthName(month)} ${widget.controller.year}',
+                textAlign: TextAlign.center,
+                style: Theme.of(context).textTheme.titleLarge,
+              ),
+            ),
+            IconButton(
+              onPressed: month == 12 ? null : () => setState(() => month += 1),
+              icon: const Icon(Icons.chevron_right),
+            ),
+          ],
+        ),
+        const SizedBox(height: 8),
+        const Row(
+          children: [
+            _Dow('Mon'),
+            _Dow('Tue'),
+            _Dow('Wed'),
+            _Dow('Thu'),
+            _Dow('Fri'),
+            _Dow('Sat'),
+            _Dow('Sun'),
+          ],
+        ),
+        GridView.builder(
+          shrinkWrap: true,
+          physics: const NeverScrollableScrollPhysics(),
+          gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(
+            crossAxisCount: 7,
+            mainAxisSpacing: 6,
+            crossAxisSpacing: 6,
+          ),
+          itemCount: leading + days,
+          itemBuilder: (context, index) {
+            if (index < leading) return const SizedBox.shrink();
+            final date = LocalDate(
+              widget.controller.year,
+              month,
+              index - leading + 1,
+            );
+            final assignment = byDate[date];
+            return _DayCell(
+              assignment: assignment,
+              onTap: assignment == null
+                  ? null
+                  : () => _show(context, assignment),
+            );
+          },
+        ),
+        const SizedBox(height: 16),
+        const Wrap(
+          spacing: 12,
+          runSpacing: 8,
+          children: [
+            _Legend(color: accent, label: 'Wake-up country'),
+            _Legend(color: transit, label: 'In transit at wake-up'),
+            _Legend(color: Color(0xFFE7E0D6), label: 'Unknown'),
+            _Legend(color: Color(0xFFF3D6C8), label: 'Unresolved overlap'),
+            _Legend(color: layoverAmber, label: 'Layover dot'),
+          ],
+        ),
+      ],
+    );
+  }
+
+  void _show(BuildContext context, DayAssignment day) {
+    final kind = switch (day.kind) {
+      DayKind.primaryCountry =>
+        'Wake-up country: ${countryLabel(day.primaryCountry ?? '')}',
+      DayKind.inTransit => 'Wake-up was in transit.',
+      DayKind.gap => 'No countable stay covers this date.',
+      DayKind.overlap =>
+        'Unresolved wake-up countries: ${day.overlapCountries.map(countryLabel).join(', ')}',
+      DayKind.future =>
+        'This date is after today, so it is outside the actual total.',
+    };
+    final extras = <String>[
+      if (day.layoverCountries.isNotEmpty)
+        'Layover, kept separate: ${day.layoverCountries.map(countryLabel).join(', ')}',
+      if (day.overnight)
+        'Overnight night in transit, kept out of the country total.',
+      if (day.plannedCountries.isNotEmpty)
+        'Planned: ${day.plannedCountries.map(countryLabel).join(', ')}',
+      if (day.futureActualCountries.isNotEmpty)
+        'Stored as actual, still in the future: ${day.futureActualCountries.map(countryLabel).join(', ')}',
+    ];
+    showModalBottomSheet<void>(
+      context: context,
+      showDragHandle: true,
+      builder: (context) => Padding(
+        padding: const EdgeInsets.fromLTRB(20, 0, 20, 28),
+        child: Column(
+          mainAxisSize: MainAxisSize.min,
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            Text(
+              shortDate(day.date),
+              style: Theme.of(context).textTheme.titleLarge,
+            ),
+            const SizedBox(height: 8),
+            Text(kind),
+            for (final extra in extras) ...[
+              const SizedBox(height: 6),
+              Text(extra),
+            ],
+          ],
+        ),
+      ),
+    );
+  }
+}
+
+class _DayCell extends StatelessWidget {
+  const _DayCell({required this.assignment, required this.onTap});
+
+  final DayAssignment? assignment;
+  final VoidCallback? onTap;
+
+  @override
+  Widget build(BuildContext context) {
+    final day = assignment;
+    Color background = const Color(0xFFE7E0D6);
+    Border? border;
+    if (day != null) {
+      background = switch (day.kind) {
+        DayKind.primaryCountry => countryColor(
+          day.primaryCountry ?? '',
+        ).withValues(alpha: 0.85),
+        DayKind.inTransit => transit,
+        DayKind.gap => const Color(0xFFE7E0D6),
+        DayKind.overlap => const Color(0xFFF3D6C8),
+        DayKind.future => card,
+      };
+      if (day.kind == DayKind.future &&
+          (day.plannedCountries.isNotEmpty ||
+              day.futureActualCountries.isNotEmpty)) {
+        border = Border.all(color: const Color(0xFF8A734A), width: 1.4);
+      }
+    }
+    final foreground =
+        day?.kind == DayKind.primaryCountry || day?.kind == DayKind.inTransit
+        ? Colors.white
+        : ink;
+    return Material(
+      color: background,
+      shape: RoundedRectangleBorder(
+        borderRadius: BorderRadius.circular(10),
+        side: border?.top ?? const BorderSide(color: line),
+      ),
+      child: InkWell(
+        onTap: onTap,
+        borderRadius: BorderRadius.circular(10),
+        child: Stack(
+          children: [
+            Padding(
+              padding: const EdgeInsets.all(6),
+              child: Text(
+                '${day?.date.day ?? ''}',
+                style: TextStyle(
+                  color: foreground,
+                  fontWeight: FontWeight.w600,
+                ),
+              ),
+            ),
+            if (day != null && day.layoverCountries.isNotEmpty)
+              const Positioned(
+                right: 6,
+                bottom: 6,
+                child: Icon(Icons.circle, size: 8, color: layoverAmber),
+              ),
+            if (day != null && day.overnight)
+              Positioned(
+                left: 6,
+                bottom: 4,
+                child: Icon(
+                  Icons.flight,
+                  size: 12,
+                  color: foreground.withValues(alpha: 0.9),
+                ),
+              ),
+          ],
+        ),
+      ),
+    );
+  }
+}
+
+class _Dow extends StatelessWidget {
+  const _Dow(this.label);
+  final String label;
+
+  @override
+  Widget build(BuildContext context) {
+    return Expanded(
+      child: Text(
+        label,
+        textAlign: TextAlign.center,
+        style: const TextStyle(fontSize: 12, color: Color(0xFF5C564E)),
+      ),
+    );
+  }
+}
+
+class _Legend extends StatelessWidget {
+  const _Legend({required this.color, required this.label});
+
+  final Color color;
+  final String label;
+
+  @override
+  Widget build(BuildContext context) {
+    return Row(
+      mainAxisSize: MainAxisSize.min,
+      children: [
+        Container(
+          width: 12,
+          height: 12,
+          decoration: BoxDecoration(
+            color: color,
+            borderRadius: BorderRadius.circular(3),
+          ),
+        ),
+        const SizedBox(width: 6),
+        Text(label),
+      ],
+    );
+  }
+}
diff --git a/lib/ui/flight_editor.dart b/lib/ui/flight_editor.dart
new file mode 100644
index 0000000..6a665c5
--- /dev/null
+++ b/lib/ui/flight_editor.dart
@@ -0,0 +1,354 @@
+import 'package:flutter/material.dart';
+
+import '../data/countries.dart';
+import '../engine/local_date.dart';
+import '../engine/models.dart';
+import 'format.dart';
+
+Future<FlightRecord?> showFlightEditor(
+  BuildContext context, {
+  FlightRecord? existing,
+  required List<EvidenceStatusDef> statuses,
+}) {
+  return showDialog<FlightRecord>(
+    context: context,
+    builder: (context) => _FlightEditor(existing: existing, statuses: statuses),
+  );
+}
+
+class _FlightEditor extends StatefulWidget {
+  const _FlightEditor({required this.statuses, this.existing});
+
+  final FlightRecord? existing;
+  final List<EvidenceStatusDef> statuses;
+
+  @override
+  State<_FlightEditor> createState() => _FlightEditorState();
+}
+
+class _FlightEditorState extends State<_FlightEditor> {
+  late final TextEditingController number;
+  late final TextEditingController fromIata;
+  late final TextEditingController toIata;
+  late final TextEditingController notes;
+  late final TextEditingController externalId;
+  late String fromCountry;
+  late String toCountry;
+  late String departZone;
+  late String arriveZone;
+  late String evidence;
+  late InferenceKind inference;
+  late FlightReviewState review;
+  late LocalDate departDate;
+  late LocalDate arriveDate;
+  late final TextEditingController departClock;
+  late final TextEditingController arriveClock;
+  String? problem;
+
+  @override
+  void initState() {
+    super.initState();
+    final existing = widget.existing;
+    final today = LocalDate.todayDevice();
+    number = TextEditingController(text: existing?.flightNumber ?? '');
+    fromIata = TextEditingController(text: existing?.fromIata ?? '');
+    toIata = TextEditingController(text: existing?.toIata ?? '');
+    notes = TextEditingController(text: existing?.notes ?? '');
+    externalId = TextEditingController(text: existing?.externalId ?? '');
+    fromCountry = existing?.fromCountry ?? '';
+    toCountry = existing?.toCountry ?? '';
+    departZone = existing?.departTimezone ?? 'Etc/UTC';
+    arriveZone = existing?.arriveTimezone ?? 'Etc/UTC';
+    evidence = existing?.evidenceStatus ?? 'booking_only';
+    inference = existing?.inference ?? InferenceKind.none;
+    review = existing?.reviewState ?? FlightReviewState.pending;
+    departDate = existing?.depart.date ?? today;
+    arriveDate = existing?.arrive.date ?? today;
+    departClock = TextEditingController(
+      text: existing == null
+          ? '09:00'
+          : '${existing.depart.hour.toString().padLeft(2, '0')}:${existing.depart.minute.toString().padLeft(2, '0')}',
+    );
+    arriveClock = TextEditingController(
+      text: existing == null
+          ? '12:00'
+          : '${existing.arrive.hour.toString().padLeft(2, '0')}:${existing.arrive.minute.toString().padLeft(2, '0')}',
+    );
+  }
+
+  @override
+  void dispose() {
+    number.dispose();
+    fromIata.dispose();
+    toIata.dispose();
+    notes.dispose();
+    externalId.dispose();
+    departClock.dispose();
+    arriveClock.dispose();
+    super.dispose();
+  }
+
+  Future<void> _pick(bool departure) async {
+    final current = departure ? departDate : arriveDate;
+    final picked = await showDatePicker(
+      context: context,
+      initialDate: DateTime(current.year, current.month, current.day),
+      firstDate: DateTime(1970),
+      lastDate: DateTime(2100),
+    );
+    if (picked == null) return;
+    setState(() {
+      final date = LocalDate(picked.year, picked.month, picked.day);
+      if (departure) {
+        departDate = date;
+      } else {
+        arriveDate = date;
+      }
+    });
+  }
+
+  WallTime? _clock(LocalDate date, String raw) {
+    final match = RegExp(r'^(\d{2}):(\d{2})$').firstMatch(raw.trim());
+    if (match == null) return null;
+    final hour = int.parse(match.group(1)!);
+    final minute = int.parse(match.group(2)!);
+    if (hour > 23 || minute > 59) return null;
+    return WallTime(date: date, hour: hour, minute: minute);
+  }
+
+  void _save() {
+    final depart = _clock(departDate, departClock.text);
+    final arrive = _clock(arriveDate, arriveClock.text);
+    if (depart == null || arrive == null) {
+      setState(() => problem = 'Clock times use HH:MM.');
+      return;
+    }
+    final flight = FlightRecord(
+      id: widget.existing?.id ?? '',
+      flightNumber: number.text.trim().toUpperCase(),
+      fromIata: fromIata.text.trim().toUpperCase(),
+      toIata: toIata.text.trim().toUpperCase(),
+      fromCountry: fromCountry,
+      toCountry: toCountry,
+      depart: depart,
+      arrive: arrive,
+      departTimezone: departZone,
+      arriveTimezone: arriveZone,
+      evidenceStatus: evidence,
+      inference: inference,
+      reviewState: review,
+      notes: notes.text.trim(),
+      externalId: externalId.text.trim(),
+    );
+    final failure = validateFlight(flight);
+    if (failure != null) {
+      setState(() => problem = failure);
+      return;
+    }
+    Navigator.of(context).pop(flight);
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final zones = {...commonTimezones, departZone, arriveZone}.toList()..sort();
+    return AlertDialog(
+      title: Text(
+        widget.existing == null ? 'Add flight evidence' : 'Edit flight',
+      ),
+      content: SizedBox(
+        width: 520,
+        child: SingleChildScrollView(
+          child: Column(
+            mainAxisSize: MainAxisSize.min,
+            children: [
+              TextField(
+                controller: number,
+                textCapitalization: TextCapitalization.characters,
+                decoration: const InputDecoration(labelText: 'Flight number'),
+              ),
+              const SizedBox(height: 12),
+              Row(
+                children: [
+                  Expanded(child: _iata(fromIata, 'From airport')),
+                  const SizedBox(width: 8),
+                  Expanded(child: _iata(toIata, 'To airport')),
+                ],
+              ),
+              const SizedBox(height: 12),
+              _countryPicker(
+                'From country',
+                fromCountry,
+                (value) => fromCountry = value,
+              ),
+              const SizedBox(height: 12),
+              _countryPicker(
+                'To country',
+                toCountry,
+                (value) => toCountry = value,
+              ),
+              const SizedBox(height: 12),
+              Row(
+                children: [
+                  Expanded(
+                    child: OutlinedButton(
+                      onPressed: () => _pick(true),
+                      child: Text(shortDate(departDate)),
+                    ),
+                  ),
+                  const SizedBox(width: 8),
+                  SizedBox(
+                    width: 90,
+                    child: TextField(
+                      controller: departClock,
+                      decoration: const InputDecoration(labelText: 'Depart'),
+                    ),
+                  ),
+                ],
+              ),
+              const SizedBox(height: 12),
+              Row(
+                children: [
+                  Expanded(
+                    child: OutlinedButton(
+                      onPressed: () => _pick(false),
+                      child: Text(shortDate(arriveDate)),
+                    ),
+                  ),
+                  const SizedBox(width: 8),
+                  SizedBox(
+                    width: 90,
+                    child: TextField(
+                      controller: arriveClock,
+                      decoration: const InputDecoration(labelText: 'Arrive'),
+                    ),
+                  ),
+                ],
+              ),
+              const SizedBox(height: 12),
+              _zone('Departure time zone', departZone, zones, (value) {
+                setState(() => departZone = value);
+              }),
+              const SizedBox(height: 12),
+              _zone('Arrival time zone', arriveZone, zones, (value) {
+                setState(() => arriveZone = value);
+              }),
+              const SizedBox(height: 12),
+              DropdownButtonFormField<String>(
+                initialValue:
+                    widget.statuses.any((status) => status.id == evidence)
+                    ? evidence
+                    : widget.statuses.first.id,
+                decoration: const InputDecoration(labelText: 'Evidence status'),
+                items: [
+                  for (final status in widget.statuses)
+                    DropdownMenuItem(
+                      value: status.id,
+                      child: Text(status.label),
+                    ),
+                ],
+                onChanged: (value) =>
+                    setState(() => evidence = value ?? evidence),
+              ),
+              const SizedBox(height: 12),
+              DropdownButtonFormField<FlightReviewState>(
+                initialValue: review,
+                decoration: const InputDecoration(labelText: 'Review'),
+                items: [
+                  for (final value in FlightReviewState.values)
+                    DropdownMenuItem(value: value, child: Text(value.label)),
+                ],
+                onChanged: (value) => setState(() => review = value ?? review),
+              ),
+              const SizedBox(height: 12),
+              TextField(
+                controller: externalId,
+                decoration: const InputDecoration(labelText: 'External id'),
+              ),
+              const SizedBox(height: 12),
+              TextField(
+                controller: notes,
+                minLines: 2,
+                maxLines: 4,
+                decoration: const InputDecoration(labelText: 'Notes'),
+              ),
+              if (problem != null) ...[
+                const SizedBox(height: 12),
+                Text(
+                  problem!,
+                  style: TextStyle(color: Theme.of(context).colorScheme.error),
+                ),
+              ],
+            ],
+          ),
+        ),
+      ),
+      actions: [
+        TextButton(
+          onPressed: () => Navigator.of(context).pop(),
+          child: const Text('Cancel'),
+        ),
+        FilledButton(onPressed: _save, child: const Text('Save flight')),
+      ],
+    );
+  }
+
+  Widget _iata(TextEditingController controller, String label) {
+    return TextField(
+      controller: controller,
+      textCapitalization: TextCapitalization.characters,
+      decoration: InputDecoration(labelText: label),
+    );
+  }
+
+  Widget _countryPicker(
+    String label,
+    String current,
+    ValueChanged<String> onSelected,
+  ) {
+    return Autocomplete<String>(
+      initialValue: TextEditingValue(
+        text: current.isEmpty ? '' : countryLabel(current),
+      ),
+      optionsBuilder: (value) {
+        final query = value.text.trim().toLowerCase();
+        return countryNames.entries
+            .where(
+              (entry) =>
+                  query.isEmpty ||
+                  entry.key.toLowerCase().contains(query) ||
+                  entry.value.toLowerCase().contains(query),
+            )
+            .map((entry) => entry.key)
+            .take(12);
+      },
+      displayStringForOption: countryLabel,
+      onSelected: onSelected,
+      fieldViewBuilder: (context, controller, focus, onSubmit) {
+        return TextField(
+          controller: controller,
+          focusNode: focus,
+          decoration: InputDecoration(labelText: label),
+        );
+      },
+    );
+  }
+
+  Widget _zone(
+    String label,
+    String current,
+    List<String> zones,
+    ValueChanged<String> onChanged,
+  ) {
+    return DropdownButtonFormField<String>(
+      initialValue: current,
+      decoration: InputDecoration(labelText: label),
+      items: [
+        for (final zone in zones)
+          DropdownMenuItem(value: zone, child: Text(zone)),
+      ],
+      onChanged: (value) {
+        if (value != null) onChanged(value);
+      },
+    );
+  }
+}
