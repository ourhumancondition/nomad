@@ -0,0 +1,244 @@
+import 'package:flutter/material.dart';
+
+import '../engine/models.dart';
+import '../state/app_controller.dart';
+
+class RulesPage extends StatefulWidget {
+  const RulesPage({super.key, required this.controller});
+
+  final AppController controller;
+
+  @override
+  State<RulesPage> createState() => _RulesPageState();
+}
+
+class _RulesPageState extends State<RulesPage> {
+  late int wakeHour;
+  late int wakeMinute;
+  late bool includeInferred;
+  late final TextEditingController marker;
+  late List<EvidenceStatusDef> statuses;
+  final _newId = TextEditingController();
+  final _newLabel = TextEditingController();
+  String? _message;
+
+  @override
+  void initState() {
+    super.initState();
+    _load();
+  }
+
+  void _load() {
+    final rules = widget.controller.rules;
+    wakeHour = rules.wakeHour;
+    wakeMinute = rules.wakeMinute;
+    includeInferred = rules.includeInferred;
+    marker = TextEditingController(
+      text: rules.personalDayMarker?.toString() ?? '',
+    );
+    statuses = widget.controller.statuses
+        .map(
+          (status) => EvidenceStatusDef(
+            id: status.id,
+            label: status.label,
+            countsAsActual: status.countsAsActual,
+          ),
+        )
+        .toList();
+  }
+
+  @override
+  void dispose() {
+    marker.dispose();
+    _newId.dispose();
+    _newLabel.dispose();
+    super.dispose();
+  }
+
+  Future<void> _save() async {
+    final rawMarker = marker.text.trim();
+    int? personal;
+    if (rawMarker.isNotEmpty) {
+      personal = int.tryParse(rawMarker);
+      if (personal == null || personal < 1 || personal > 366) {
+        setState(
+          () => _message =
+              'A personal marker is a whole number from 1 to 366, or blank.',
+        );
+        return;
+      }
+    }
+    final failure = await widget.controller.saveRules(
+      nextRules: CountingRules(
+        wakeHour: wakeHour,
+        wakeMinute: wakeMinute,
+        includeInferred: includeInferred,
+        personalDayMarker: personal,
+      ),
+      nextStatuses: statuses,
+    );
+    if (!mounted) return;
+    setState(() => _message = failure ?? 'Rules saved in this dataset.');
+  }
+
+  void _addStatus() {
+    final id = _newId.text.trim();
+    final label = _newLabel.text.trim();
+    if (!statusIdPattern.hasMatch(id) || label.isEmpty) {
+      setState(() {
+        _message = 'New statuses need a lowercase id and a label.';
+      });
+      return;
+    }
+    setState(() {
+      statuses = [
+        ...statuses,
+        EvidenceStatusDef(id: id, label: label, countsAsActual: false),
+      ];
+      _newId.clear();
+      _newLabel.clear();
+      _message = null;
+    });
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final bookingCounts = statuses.any(
+      (status) => status.id == 'booking_only' && status.countsAsActual,
+    );
+    return ListView(
+      padding: const EdgeInsets.fromLTRB(20, 8, 20, 32),
+      children: [
+        Text(
+          'Counting rules',
+          style: Theme.of(context).textTheme.headlineSmall,
+        ),
+        const SizedBox(height: 8),
+        const Text(
+          'Wake time and evidence are yours to change. The list below stays fixed so empty days, overlaps, and future dates are not quietly rewritten.',
+        ),
+        const SizedBox(height: 12),
+        for (final statement in lockedRuleStatements)
+          Padding(
+            padding: const EdgeInsets.only(bottom: 6),
+            child: Text('• $statement'),
+          ),
+        const SizedBox(height: 12),
+        Row(
+          children: [
+            Expanded(
+              child: DropdownButtonFormField<int>(
+                initialValue: wakeHour,
+                decoration: const InputDecoration(labelText: 'Wake hour'),
+                items: [
+                  for (var hour = 0; hour < 24; hour++)
+                    DropdownMenuItem(
+                      value: hour,
+                      child: Text(hour.toString().padLeft(2, '0')),
+                    ),
+                ],
+                onChanged: (value) =>
+                    setState(() => wakeHour = value ?? wakeHour),
+              ),
+            ),
+            const SizedBox(width: 8),
+            Expanded(
+              child: DropdownButtonFormField<int>(
+                initialValue: wakeMinute,
+                decoration: const InputDecoration(labelText: 'Wake minute'),
+                items: [
+                  for (final minute in [0, 15, 30, 45])
+                    DropdownMenuItem(
+                      value: minute,
+                      child: Text(minute.toString().padLeft(2, '0')),
+                    ),
+                ],
+                onChanged: (value) =>
+                    setState(() => wakeMinute = value ?? wakeMinute),
+              ),
+            ),
+          ],
+        ),
+        SwitchListTile(
+          contentPadding: EdgeInsets.zero,
+          value: includeInferred,
+          onChanged: (value) => setState(() => includeInferred = value),
+          title: const Text('Count records that are still marked as inference'),
+          subtitle: const Text(
+            'Observed records are unchanged. An inference mark stays visible either way.',
+          ),
+        ),
+        TextField(
+          controller: marker,
+          keyboardType: TextInputType.number,
+          decoration: const InputDecoration(
+            labelText: 'Personal day marker',
+            helperText: 'Optional. Highlights a country when its wake-up days reach this number. It is a reminder you chose. It is not a legal test.',
+          ),
+        ),
+        const SizedBox(height: 16),
+        Text(
+          'Evidence statuses',
+          style: Theme.of(context).textTheme.titleMedium,
+        ),
+        const SizedBox(height: 8),
+        if (bookingCounts)
+          const Text(
+            'Booking only is set to count. Uncorroborated bookings will enter the actual total.',
+          ),
+        for (var index = 0; index < statuses.length; index++)
+          SwitchListTile(
+            contentPadding: EdgeInsets.zero,
+            value: statuses[index].countsAsActual,
+            title: Text('${statuses[index].label} (${statuses[index].id})'),
+            subtitle: lockedStatusIds.contains(statuses[index].id)
+                ? const Text('Built-in status')
+                : TextButton(
+                    onPressed: () => setState(() {
+                      statuses = [...statuses]..removeAt(index);
+                    }),
+                    child: const Text('Remove'),
+                  ),
+            onChanged: (value) => setState(() {
+              statuses[index] = statuses[index].copyWith(countsAsActual: value);
+            }),
+          ),
+        const SizedBox(height: 8),
+        Row(
+          children: [
+            Expanded(
+              child: TextField(
+                controller: _newId,
+                decoration: const InputDecoration(labelText: 'New status id'),
+              ),
+            ),
+            const SizedBox(width: 8),
+            Expanded(
+              child: TextField(
+                controller: _newLabel,
+                decoration: const InputDecoration(labelText: 'Label'),
+              ),
+            ),
+          ],
+        ),
+        const SizedBox(height: 8),
+        OutlinedButton(onPressed: _addStatus, child: const Text('Add status')),
+        const SizedBox(height: 16),
+        FilledButton(onPressed: _save, child: const Text('Save rules')),
+        if (_message != null) ...[const SizedBox(height: 12), Text(_message!)],
+        const SizedBox(height: 24),
+        Text(
+          widget.controller.isConnected
+              ? 'Connected to ${widget.controller.instanceOrigin}. Sign out from the header when you want this database closed.'
+              : 'Rules in the example dataset stay in this tab.',
+          style: const TextStyle(color: Color(0xFF5C564E)),
+        ),
+        if (widget.controller.isConnected)
+          TextButton(
+            onPressed: widget.controller.signOut,
+            child: const Text('Sign out'),
+          ),
+      ],
+    );
+  }
+}
diff --git a/lib/ui/stay_editor.dart b/lib/ui/stay_editor.dart
new file mode 100644
index 0000000..40b8d46
--- /dev/null
+++ b/lib/ui/stay_editor.dart
@@ -0,0 +1,284 @@
+import 'package:flutter/material.dart';
+
+import '../data/countries.dart';
+import '../engine/local_date.dart';
+import '../engine/models.dart';
+import 'format.dart';
+
+Future<Stay?> showStayEditor(
+  BuildContext context, {
+  Stay? existing,
+  LocalDate? initialStart,
+  LocalDate? initialEnd,
+  required List<EvidenceStatusDef> statuses,
+}) {
+  return showDialog<Stay>(
+    context: context,
+    builder: (context) => _StayEditor(
+      existing: existing,
+      initialStart: initialStart,
+      initialEnd: initialEnd,
+      statuses: statuses,
+    ),
+  );
+}
+
+class _StayEditor extends StatefulWidget {
+  const _StayEditor({
+    required this.statuses,
+    this.existing,
+    this.initialStart,
+    this.initialEnd,
+  });
+
+  final Stay? existing;
+  final LocalDate? initialStart;
+  final LocalDate? initialEnd;
+  final List<EvidenceStatusDef> statuses;
+
+  @override
+  State<_StayEditor> createState() => _StayEditorState();
+}
+
+class _StayEditorState extends State<_StayEditor> {
+  late PresenceRole role;
+  late InferenceKind inference;
+  late TripPhase phase;
+  late String evidence;
+  late String country;
+  late String timezone;
+  late LocalDate start;
+  late LocalDate end;
+  late final TextEditingController notes;
+  late final TextEditingController externalId;
+  String? problem;
+
+  @override
+  void initState() {
+    super.initState();
+    final existing = widget.existing;
+    final today = LocalDate.todayDevice();
+    role = existing?.role ?? PresenceRole.primary;
+    inference = existing?.inference ?? InferenceKind.none;
+    phase = existing?.phase ?? TripPhase.actual;
+    evidence = existing?.evidenceStatus ?? 'confirmed';
+    country = existing?.countryCode ?? '';
+    timezone = existing?.timezone ?? 'Etc/UTC';
+    start = existing?.start ?? widget.initialStart ?? today;
+    end = existing?.end ?? widget.initialEnd ?? start;
+    notes = TextEditingController(text: existing?.notes ?? '');
+    externalId = TextEditingController(text: existing?.externalId ?? '');
+  }
+
+  @override
+  void dispose() {
+    notes.dispose();
+    externalId.dispose();
+    super.dispose();
+  }
+
+  bool get needsCountry =>
+      role == PresenceRole.primary || role == PresenceRole.layover;
+
+  Future<void> _pick(bool isStart) async {
+    final current = isStart ? start : end;
+    final picked = await showDatePicker(
+      context: context,
+      initialDate: DateTime(current.year, current.month, current.day),
+      firstDate: DateTime(1970),
+      lastDate: DateTime(2100),
+    );
+    if (picked == null) return;
+    setState(() {
+      final date = LocalDate(picked.year, picked.month, picked.day);
+      if (isStart) {
+        start = date;
+        if (end < start) end = start;
+      } else {
+        end = date;
+      }
+    });
+  }
+
+  void _save() {
+    final stay = Stay(
+      id: widget.existing?.id ?? '',
+      countryCode: needsCountry ? country : '',
+      start: start,
+      end: end,
+      role: role,
+      evidenceStatus: evidence,
+      inference: inference,
+      phase: phase,
+      timezone: timezone,
+      notes: notes.text.trim(),
+      externalId: externalId.text.trim(),
+      source: widget.existing?.source ?? RecordSource.manual,
+    );
+    final failure = validateStay(stay);
+    if (failure != null) {
+      setState(() => problem = failure);
+      return;
+    }
+    Navigator.of(context).pop(stay);
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final zones = {...commonTimezones, timezone}.toList()..sort();
+    final evidenceIds = widget.statuses.map((status) => status.id).toSet();
+    final evidenceValue = evidenceIds.contains(evidence)
+        ? evidence
+        : widget.statuses.first.id;
+    return AlertDialog(
+      title: Text(widget.existing == null ? 'Add a stay' : 'Edit stay'),
+      content: SizedBox(
+        width: 460,
+        child: SingleChildScrollView(
+          child: Column(
+            mainAxisSize: MainAxisSize.min,
+            children: [
+              DropdownButtonFormField<PresenceRole>(
+                initialValue: role,
+                decoration: const InputDecoration(labelText: 'Role'),
+                items: [
+                  for (final value in PresenceRole.values)
+                    DropdownMenuItem(value: value, child: Text(value.label)),
+                ],
+                onChanged: (value) => setState(() => role = value ?? role),
+              ),
+              const SizedBox(height: 12),
+              if (needsCountry)
+                Autocomplete<String>(
+                  initialValue: TextEditingValue(text: countryLabel(country)),
+                  optionsBuilder: (value) {
+                    final query = value.text.trim().toLowerCase();
+                    if (query.isEmpty) return countryNames.keys.take(8);
+                    return countryNames.entries
+                        .where(
+                          (entry) =>
+                              entry.key.toLowerCase().contains(query) ||
+                              entry.value.toLowerCase().contains(query),
+                        )
+                        .map((entry) => entry.key)
+                        .take(12);
+                  },
+                  displayStringForOption: countryLabel,
+                  onSelected: (code) => country = code,
+                  fieldViewBuilder: (context, controller, focus, onSubmit) {
+                    return TextField(
+                      controller: controller,
+                      focusNode: focus,
+                      decoration: const InputDecoration(labelText: 'Country'),
+                      onChanged: (value) {
+                        final code = value.trim().toUpperCase();
+                        if (RegExp(r'^[A-Z]{2}$').hasMatch(code)) {
+                          country = code;
+                        }
+                      },
+                    );
+                  },
+                ),
+              const SizedBox(height: 12),
+              Row(
+                children: [
+                  Expanded(
+                    child: OutlinedButton(
+                      onPressed: () => _pick(true),
+                      child: Text('Start ${shortDate(start)}'),
+                    ),
+                  ),
+                  const SizedBox(width: 8),
+                  Expanded(
+                    child: OutlinedButton(
+                      onPressed: () => _pick(false),
+                      child: Text('End ${shortDate(end)}'),
+                    ),
+                  ),
+                ],
+              ),
+              const SizedBox(height: 12),
+              DropdownButtonFormField<String>(
+                initialValue: evidenceValue,
+                decoration: const InputDecoration(labelText: 'Evidence status'),
+                items: [
+                  for (final status in widget.statuses)
+                    DropdownMenuItem(
+                      value: status.id,
+                      child: Text(status.label),
+                    ),
+                ],
+                onChanged: (value) =>
+                    setState(() => evidence = value ?? evidence),
+              ),
+              const SizedBox(height: 12),
+              DropdownButtonFormField<InferenceKind>(
+                initialValue: inference,
+                decoration: const InputDecoration(labelText: 'Inference'),
+                items: [
+                  for (final value in InferenceKind.values)
+                    DropdownMenuItem(value: value, child: Text(value.label)),
+                ],
+                onChanged: (value) =>
+                    setState(() => inference = value ?? inference),
+              ),
+              const SizedBox(height: 12),
+              DropdownButtonFormField<TripPhase>(
+                initialValue: phase,
+                decoration: const InputDecoration(labelText: 'Phase'),
+                items: [
+                  for (final value in TripPhase.values)
+                    DropdownMenuItem(value: value, child: Text(value.label)),
+                ],
+                onChanged: (value) => setState(() => phase = value ?? phase),
+              ),
+              const SizedBox(height: 12),
+              DropdownButtonFormField<String>(
+                initialValue: timezone,
+                decoration: const InputDecoration(
+                  labelText: 'Time zone of the dates',
+                ),
+                items: [
+                  for (final zone in zones)
+                    DropdownMenuItem(value: zone, child: Text(zone)),
+                ],
+                onChanged: (value) =>
+                    setState(() => timezone = value ?? timezone),
+              ),
+              const SizedBox(height: 12),
+              TextField(
+                controller: externalId,
+                decoration: const InputDecoration(
+                  labelText: 'External id',
+                  helperText:
+                      'Matches a row in your sheet when you import again.',
+                ),
+              ),
+              const SizedBox(height: 12),
+              TextField(
+                controller: notes,
+                minLines: 2,
+                maxLines: 4,
+                decoration: const InputDecoration(labelText: 'Notes'),
+              ),
+              if (problem != null) ...[
+                const SizedBox(height: 12),
+                Text(
+                  problem!,
+                  style: TextStyle(color: Theme.of(context).colorScheme.error),
+                ),
+              ],
+            ],
+          ),
+        ),
+      ),
+      actions: [
+        TextButton(
+          onPressed: () => Navigator.of(context).pop(),
+          child: const Text('Cancel'),
+        ),
+        FilledButton(onPressed: _save, child: const Text('Save stay')),
+      ],
+    );
+  }
+}
diff --git a/lib/ui/stays_page.dart b/lib/ui/stays_page.dart
